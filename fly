local TARGET_STEPPING = Enum.PhysicsSteppingMethod.Fixed
local TARGET_FPSCAP   = 240

local function applyPhysicsSettings()
    pcall(function()
        if workspace.PhysicsSteppingMethod ~= TARGET_STEPPING then
            workspace.PhysicsSteppingMethod = TARGET_STEPPING
        end
    end)
end

local function applyFpsCap()
    pcall(function() setfpscap(TARGET_FPSCAP) end)
end

