-- ─── FLY ───
local function cleanChar(char)
    for _,v in ipairs(char:GetDescendants()) do
        if v.Name == "FlyScript_Vel" or v.Name == "FlyScript_Gyro" then
            v:Destroy()
        end
    end
end

local function setup(char)
    cleanChar(char)
    root = char:WaitForChild("HumanoidRootPart", 5)
    hum  = char:WaitForChild("Humanoid", 5)
end

local function ensureChar()
    if root and root.Parent and hum and hum.Parent then return true end
    if player.Character then
        setup(player.Character)
        return root ~= nil and hum ~= nil
    end
    return false
end

local function makeBV()
    local v = Instance.new("BodyVelocity")
    v.Name = "FlyScript_Vel"
    v.MaxForce = Vector3.new(1e6, 1e6, 1e6)
    v.Velocity = curVel
    v.Parent = root
    return v
end

local function makeBG()
    local g = Instance.new("BodyGyro")
    g.Name = "FlyScript_Gyro"
    g.MaxTorque = Vector3.new(1e6, 1e6, 1e6)
    g.P = 8000
    g.D = 1000
    g.CFrame = root and root.CFrame or CFrame.new()
    g.Parent = root
    return g
end

if player.Character then setup(player.Character) end

player.CharacterAdded:Connect(function(c)
    flying = false
    bv, bg = nil, nil
    if Controls then pcall(function() Controls:Enable() end) end

    task.wait(0.5)

    setup(c)
    applyPhysicsSettings()
    applyFpsCap()
    refreshUI()
end)

local function startFly()
    if not ensureChar() then
        if DEBUG then warn("[FlyScript] ตัวละครยังไม่พร้อม") end
        return
    end
    if not ALLOWED_IDS[player.UserId] then return end

    savedWalk = hum.WalkSpeed
    savedJump = hum.JumpPower

    bv = makeBV()
    bg = makeBG()

    curVel = Vector3.zero
    flying = true

    hum.PlatformStand = true
    hum.WalkSpeed = 0
    hum.JumpPower = 0
    if Controls then pcall(function() Controls:Disable() end) end

    pcall(function()
        hum:SetStateEnabled(Enum.HumanoidStateType.Freefall, false)
        hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
        hum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
    end)

    refreshUI()
end

local function stopFly()
    flying = false
    if bv then bv:Destroy(); bv = nil end
    if bg then bg:Destroy(); bg = nil end

    if hum then
        hum.PlatformStand = false
        hum.WalkSpeed = savedWalk or 16
        hum.JumpPower = savedJump or 50
        hum:ChangeState(Enum.HumanoidStateType.GettingUp)

        pcall(function()
            hum:SetStateEnabled(Enum.HumanoidStateType.Freefall, true)
            hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, true)
            hum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, true)
        end)
    end
    if Controls then pcall(function() Controls:Enable() end) end
    curVel = Vector3.zero
    refreshUI()
end

