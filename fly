local sliderDragging = false
local function updateSlider(mouseX)
    local ax = slider.AbsolutePosition.X
    local aw = slider.AbsoluteSize.X
    local alpha = math.clamp((mouseX - ax) / aw, 0, 1)
    local ratio = MAX_SPEED / MIN_SPEED
    setSpeedValue(MIN_SPEED * (ratio ^ alpha))
end
hitbox.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then
        sliderDragging = true
        updateSlider(input.Position.X)
    end
end)
UIS.InputChanged:Connect(function(input)
    if sliderDragging and (input.UserInputType == Enum.UserInputType.MouseMovement
    or input.UserInputType == Enum.UserInputType.Touch) then
        updateSlider(input.Position.X)
    end
end)
UIS.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then
        sliderDragging = false
    end
end)

-- ═══════════════════════════════════════════
--  🔄 UPDATE LOOP + 🛡️ FLY WATCHDOG
-- ═══════════════════════════════════════════
local wdControlsAccum = 0
local wdHumanoidAccum = 0

RunService.PreSimulation:Connect(function(dt)
    if not flying then return end

    -- 1) ตรวจสอบตัวละคร
    if not root or not root.Parent or not hum or not hum.Parent then
        if not ensureChar() then
            stopFly()
            return
        end
    end

    -- 2) BodyVelocity integrity
    if not bv or not bv.Parent or bv.Parent ~= root then
        if bv and bv.Parent then pcall(function() bv:Destroy() end) end
        bv = makeBV()
    end

    -- 3) BodyGyro integrity
    if not bg or not bg.Parent or bg.Parent ~= root then
        if bg and bg.Parent then pcall(function() bg:Destroy() end) end
        bg = makeBG()
    end

    -- 4) 🛡️ Humanoid state guard
    wdHumanoidAccum += dt
    if wdHumanoidAccum >= 0.1 then
        wdHumanoidAccum = 0
        if hum then
            if not hum.PlatformStand then hum.PlatformStand = true end
            if hum.WalkSpeed ~= 0 then hum.WalkSpeed = 0 end
            if hum.JumpPower ~= 0 then hum.JumpPower = 0 end

            local currentState = hum:GetState()
            if currentState == Enum.HumanoidStateType.Freefall
            or currentState == Enum.HumanoidStateType.FallingDown
            or currentState == Enum.HumanoidStateType.Ragdoll
            or currentState == Enum.HumanoidStateType.Landed then
                hum:ChangeState(Enum.HumanoidStateType.Physics)
            end
        end
    end

    -- 5) Controls guard (ทุก ~0.5s)
    wdControlsAccum += dt
    if wdControlsAccum >= 0.5 then
        wdControlsAccum = 0
        if Controls then pcall(function() Controls:Disable() end) end
    end

    -- 6) อัปเดตการบิน
    local cam = workspace.CurrentCamera
    if not cam then return end

    local cf = cam.CFrame

    if typing then
        curVel = curVel:Lerp(Vector3.zero, 1 - math.exp(-VEL_SMOOTH * dt))
        bv.Velocity = curVel
        return
    end

    local dir = Vector3.zero
    if UIS:IsKeyDown(Enum.KeyCode.W) then dir += cf.LookVector  end
    if UIS:IsKeyDown(Enum.KeyCode.S) then dir -= cf.LookVector  end
    if UIS:IsKeyDown(Enum.KeyCode.D) then dir += cf.RightVector end
    if UIS:IsKeyDown(Enum.KeyCode.A) then dir -= cf.RightVector end
    -- ↑ Space/Shift ถูกลบออกแล้ว (ไม่มี vertical movement)

    local target = dir.Magnitude > 0.01 and dir.Unit * SPEED or Vector3.zero
    curVel = curVel:Lerp(target, 1 - math.exp(-VEL_SMOOTH * dt))
    bv.Velocity = curVel

    bg.CFrame = bg.CFrame:Lerp(cf, 1 - math.exp(-ROT_SMOOTH * dt))
end)

-- ─── DEATH SAFETY ───
player.CharacterRemoving:Connect(function()
    if flying then stopFly() end
end)

