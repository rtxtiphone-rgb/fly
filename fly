-- ─── INPUT (Capture + Toggle) ───
UIS.InputBegan:Connect(function(i, gp)
    if capturingKey then
        if tick() - captureStart < 0.2 then return end
        if gp and i.UserInputType == Enum.UserInputType.Keyboard then return end

        local uiType = i.UserInputType
        if uiType == Enum.UserInputType.Keyboard then
            if i.KeyCode == Enum.KeyCode.Unknown or i.KeyCode == Enum.KeyCode.Escape then
                capturingKey = false
                keybindBtn.TextColor3 = C.accent
                keybindTitle.Text = "Toggle Key"
                keybindTitle.TextColor3 = C.textDim
                updateKeybindLabel()
                return
            end
            TOGGLE_KEY = i.KeyCode
            TOGGLE_MOUSE = nil
        elseif uiType == Enum.UserInputType.MouseButton1
            or uiType == Enum.UserInputType.MouseButton2
            or uiType == Enum.UserInputType.MouseButton3 then
            TOGGLE_MOUSE = uiType
        else
            capturingKey = false
            keybindBtn.TextColor3 = C.accent
            keybindTitle.Text = "Toggle Key"
            keybindTitle.TextColor3 = C.textDim
            updateKeybindLabel()
            return
        end

        capturingKey = false
        keybindBtn.TextColor3 = C.accent
        keybindTitle.Text = "Toggle Key"
        keybindTitle.TextColor3 = C.textDim
        updateKeybindLabel()
        return
    end

    if gp then return end
    if typing then return end

    local isToggle
    if TOGGLE_MOUSE then
        isToggle = (i.UserInputType == TOGGLE_MOUSE)
    else
        isToggle = (i.UserInputType == Enum.UserInputType.Keyboard
                    and i.KeyCode == TOGGLE_KEY)
    end

    if isToggle then
        if flying then stopFly() else startFly() end
    end
end)

