--  🎯 SPEED SETTER (single source of truth)
-- ═══════════════════════════════════════════
local function setSpeedValue(v)
    local n = tonumber(v)
    if not n then return SPEED end
    n = math.clamp(math.floor(n + 0.5), MIN_SPEED, MAX_SPEED)
    SPEED = n

    local alpha = math.log(n / MIN_SPEED) / math.log(MAX_SPEED / MIN_SPEED)
    fill.Size     = UDim2.new(alpha, 0, 1, 0)
    knob.Position = UDim2.new(alpha, 0, 0.5, 0)

    if speedInput.Text ~= tostring(n) then
        speedInput.Text = tostring(n)
    end
    return n
end

