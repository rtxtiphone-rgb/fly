local resizing = false
local resizeStartX, resizeStartY, resizeStartScale
local lastClickTime = 0

resizeHandle.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then
        resizing = true
        resizeStartX = input.Position.X
        resizeStartY = input.Position.Y
        resizeStartScale = uiScale.Scale

        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            local now = tick()
            if now - lastClickTime < 0.35 then
                setUIScale(1)
                resizing = false
            end
            lastClickTime = now
        end
    end
end)

UIS.InputChanged:Connect(function(input)
    if resizing and (input.UserInputType == Enum.UserInputType.MouseMovement
    or input.UserInputType == Enum.UserInputType.Touch) then
        local dx = input.Position.X - resizeStartX
        local dy = input.Position.Y - resizeStartY
        setUIScale(resizeStartScale + (dx + dy) / 400)
    end
end)

UIS.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then
        resizing = false
    end
end)

