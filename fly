    workspace:GetPropertyChangedSignal("PhysicsSteppingMethod"):Connect(applyPhysicsSettings)
end)

local physAccum, fpsAccum = 0, 0
RunService.Heartbeat:Connect(function(dt)
    physAccum += dt
    fpsAccum  += dt
    if physAccum >= 0.5 then
        physAccum = 0
        applyPhysicsSettings()
    end
    if fpsAccum >= 5 then
        fpsAccum = 0
        applyFpsCap()
    end
end)

